PORT=8787
CORS_ORIGIN=*
GDRIVE_BODY_LIMIT=180mb
GDRIVE_MAX_BYTES=104857600

# One of the following credential options is required:
# Option A: Full JSON (base64)
GDRIVE_SERVICE_ACCOUNT_JSON_BASE64=

# Option B: Full JSON (raw string)
GDRIVE_SERVICE_ACCOUNT_JSON=

# Option C: Split values
GDRIVE_CLIENT_EMAIL=
GDRIVE_PRIVATE_KEY=

# Optional
GDRIVE_FOLDER_ID=
GDRIVE_SHARED_DRIVE_ID=
GDRIVE_ALLOW_PUBLIC=true
GDRIVE_FORWARD_URL=
